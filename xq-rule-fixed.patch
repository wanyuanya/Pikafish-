+// SkyRule: update continuous chase state after making a move
+void Position::update_sky_chase_state(StateInfo* st, Color us) {
+    if (!SkyRule)
+        return;
+
+    Color them = ~us;
+    u16 currentChases = chased(them);  // which of our pieces are being chased by them?
+
+    if (!currentChases)
+    {
+        // No chases this move - reset streak
+        st->skyChaser[us] = SQ_NONE;
+        st->skyChased[us] = SQ_NONE;
+        st->skyChaseStreak[us] = 0;
+        return;
+    }
+
+    // Find the piece that just moved - it might be the chaser
+    Square movedFrom = from_sq(st->move);
+
+    // Check if we're continuing the same chase (same attacker, same target)
+    if (st->skyChaser[us] == movedFrom && (currentChases & (1 << st->skyChased[us])))
+    {
+        // Same attacker, still chasing same target - increment streak
+        st->skyChaseStreak[us]++;
+    }
+    else
+    {
+        // New chase - start streak at 1
+        st->skyChaser[us] = movedFrom;
+        st->skyChased[us] = Square(lsb(currentChases));  // first chased piece
+        st->skyChaseStreak[us] = 1;
+    }
+}
